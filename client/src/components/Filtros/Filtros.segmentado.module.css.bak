.filtros {
    width: 100%;
    height: 20vh;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.1rem;
    font-size: 1.2rem;
}

.filtrosWrapper {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 100%;
    gap: 1.1rem;
}

.filtrosLinea {
    width: 100%;
    height: 1px;
    background-color: #46392a;
}

.filtrosNull {
    display: none;
}

.filtrosGrupo {
    display: inline-flex;
    max-width: 100%;
    background-color: #2f2317;
    border-radius: 14px;
    padding: 6px;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
}

.filtrosBtn {
    border-radius: 10px;
    padding: 0.75rem 1.4rem;
    color: #b8a891;
    font-weight: 500;
    text-align: center;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
    cursor: pointer;
}

.filtrosBtn:hover {
    color: white;
}

.filtrosBtn.activo {
    background-color: #b69443;
    color: #1a1207;
    font-weight: 600;
}

@media screen and (max-width: 760px) {
    .filtros {
        height: auto;
        width: 100%;
        padding: 0.75rem 0;
    }

    .filtrosWrapper {
        width: 100%;
    }

    .filtrosGrupo {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        width: 100%;
        gap: 8px;
    }

    .filtrosBtn {
        padding: 0.6rem 0.3rem;
        font-size: 0.85rem;
        white-space: normal;
        line-height: 1.2;
        display: flex;
        align-items: center;
        justify-content: center;
    }
}
